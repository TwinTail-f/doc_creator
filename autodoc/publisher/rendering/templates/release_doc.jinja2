<ac:structured-macro ac:name="tabs-group">
    <ac:parameter ac:name="disposition">vertical</ac:parameter>
    <ac:parameter ac:name="outline">true</ac:parameter>
    
    <ac:rich-text-body>
        
        {% for comp in data.components %}
        {% set comp_index = loop.index %}
        <ac:structured-macro ac:name="tab-pane">
            <ac:parameter ac:name="name">{{ comp.name }}</ac:parameter>
            <ac:parameter ac:name="anchor">comp-{{ comp_index }}</ac:parameter>
            <ac:parameter ac:name="outline">true</ac:parameter>
            
            <ac:rich-text-body>
                <!-- Заголовок компонента -->
                <h1 style="margin-top: 0; margin-bottom: 6px; font-size: 26px; font-weight: 700; color: var(--ds-text, #111827);">{{ comp.name }}</h1>
                <p style="color: var(--ds-text-subtle, #6b7280); font-size: 14px; margin-top: 0; line-height: 1.5; max-width: 700px;">{{ comp.description }}</p>
                
                {% set total_profiles = namespace(value=0) %}
                {% for rel in comp.releases %}
                    {% set total_profiles.value = total_profiles.value + rel.profile_builds|length %}
                {% endfor %}

                <div style="margin-top: 12px; margin-bottom: 24px;">
                    <span style="font-size: 12px; color: var(--ds-text-subtle, #6b7280); background: var(--ds-background-neutral, #f3f4f6); border-radius: 4px; padding: 2px 8px; margin-right: 12px; display: inline-block; margin-bottom: 8px;">Платформа: <strong style="color: var(--ds-text, #374151);">{{ data.get('platform_version', '2.0') }}</strong></span>
                    <span style="font-size: 12px; color: var(--ds-text-subtle, #6b7280); background: var(--ds-background-neutral, #f3f4f6); border-radius: 4px; padding: 2px 8px; margin-right: 12px; display: inline-block; margin-bottom: 8px;">Всего профилей: <strong style="color: var(--ds-text, #374151);">{{ total_profiles.value }}</strong></span>
                </div>

                <!-- ГОРИЗОНТАЛЬНЫЕ ВКЛАДКИ КАНАЛОВ -->
                <ac:structured-macro ac:name="tabs-group">
                    <ac:parameter ac:name="disposition">horizontal</ac:parameter>
                    <ac:parameter ac:name="outline">true</ac:parameter>
                    
                    <ac:rich-text-body>
                        {% set releases_by_channel = comp.releases | groupby('channel') %}
                        {% for channel_group in releases_by_channel %}
                        {% set channel_name = channel_group.grouper %}
                        {% set releases_in_channel = channel_group.list %}
                        
                        <ac:structured-macro ac:name="tab-pane">
                            <ac:parameter ac:name="name">{{ channel_name | capitalize }}</ac:parameter>
                            <ac:parameter ac:name="anchor">chan-{{ comp_index }}-{{ loop.index }}</ac:parameter>
                            <ac:parameter ac:name="outline">true</ac:parameter>
                            
                            <ac:rich-text-body>
                                {% for release in releases_in_channel %}
                                <div style="margin-top: 24px; margin-bottom: 40px;">
                                    
                                    <!-- Reference Card (ОБНОВЛЕН ФОН ДЛЯ СВЕТЛОЙ ТЕМЫ) -->
                                    <div style="padding: 14px 18px; background: var(--ds-background-neutral, #F4F5F7); border-radius: 8px; margin-bottom: 16px;">
                                        <div style="font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--ds-text-subtle, #6b7280); margin-bottom: 6px;">Conan Reference</div>
                                        <a href="{{ release.artifactory_url }}" style="font-size: 14px; font-weight: 600; font-family: monospace; color: var(--ds-link, #2563eb); text-decoration: none;">
                                            {{ release.conan_reference }} &#8599;
                                        </a>
                                        <div style="float: right; font-size: 12px; color: var(--ds-text-subtle, #6b7280); margin-top: 2px;">
                                            Версия: <strong style="color: var(--ds-text, #374151);">{{ release.version }}</strong>
                                            {% if not release.is_header_only %}
                                             &nbsp;&bull;&nbsp; Профилей сборки: <strong style="color: var(--ds-text, #374151);">{{ release.profile_builds | length }}</strong>
                                            {% endif %}
                                        </div>
                                        <div style="clear: both;"></div>
                                    </div>

                                    {% if release.is_header_only %}
                                        <!-- Плашка для Header-Only компонентов -->
                                        <ac:structured-macro ac:name="info">
                                            <ac:rich-text-body>
                                                <p>
                                                    <strong style="color: var(--ds-text, #111827);">Header-Only компонент</strong>
                                                    <span title="Данный компонент поставляется только в виде заголовочных файлов. Он не требует компиляции, не зависит от архитектуры и универсален для любых профилей сборки платформы." style="cursor: help; margin-left: 4px; color: var(--ds-icon-information, #0052cc); vertical-align: middle;">
                                                        <ac:emoticon ac:name="information" />
                                                    </span>
                                                </p>
                                                <p style="color: var(--ds-text, #111827);">Таблицы профилей для данного компонента отсутствуют, так как он собирается одинаково для всех архитектур и ОС.</p>
                                            </ac:rich-text-body>
                                        </ac:structured-macro>
                                    {% else %}
                                        <!-- Подсказка для пользователя -->
                                        <div style="font-size: 12px; color: var(--ds-text-subtle, #6b7280); margin-bottom: 8px; margin-left: 4px;">
                                            <span style="color: var(--ds-icon-information, #0052cc); font-size: 14px; vertical-align: middle; margin-right: 4px;">&#8505;</span>
                                            <span style="vertical-align: middle;">Для просмотра списка поддерживаемых профилей ОС, архитектур и компиляторов кликните по панели ниже.</span>
                                        </div>

                                        <!-- Спойлер (Expand) -->
                                        <ac:structured-macro ac:name="expand">
                                            <ac:parameter ac:name="title">Раскрыть список профилей ({{ release.profile_builds | length }})</ac:parameter>
                                            <ac:rich-text-body>
                                                <table class="confluenceTable" style="border: 1px solid var(--ds-border, #e5e7eb); border-radius: 8px; margin-bottom: 0; width: 100%;">
                                                    <thead style="background: var(--ds-surface-sunken, #f9fafb);">
                                                        <tr>
                                                            <th class="confluenceTh" style="padding: 10px 14px; text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--ds-text-subtle, #6b7280); border-bottom: 1px solid var(--ds-border, #e5e7eb);">Профиль</th>
                                                            <th class="confluenceTh" style="padding: 10px 14px; text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--ds-text-subtle, #6b7280); border-bottom: 1px solid var(--ds-border, #e5e7eb);">OS</th>
                                                            <th class="confluenceTh" style="padding: 10px 14px; text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--ds-text-subtle, #6b7280); border-bottom: 1px solid var(--ds-border, #e5e7eb);">Архитектура</th>
                                                            <th class="confluenceTh" style="padding: 10px 14px; text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--ds-text-subtle, #6b7280); border-bottom: 1px solid var(--ds-border, #e5e7eb);">Компилятор</th>
                                                            <th class="confluenceTh" style="padding: 10px 14px; text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--ds-text-subtle, #6b7280); border-bottom: 1px solid var(--ds-border, #e5e7eb);">Docker Image</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        {% for build in release.profile_builds %}
                                                        <tr>
                                                            <td class="confluenceTd" style="padding: 12px 14px; border-bottom: 1px solid var(--ds-border, #e5e7eb); vertical-align: middle;">
                                                                <code style="font-family: monospace; font-size: 12px; color: var(--ds-text, #374151); background: transparent; border: none; padding: 0;">{{ build.profile_name }}</code>
                                                            </td>
                                                            <td class="confluenceTd" style="padding: 12px 14px; border-bottom: 1px solid var(--ds-border, #e5e7eb); vertical-align: middle;">
                                                                {% set os = build.conan_settings.get('os', 'Unknown') %}
                                                                {% set os_lower = os | lower %}
                                                                {% if 'linux' in os_lower %}
                                                                    {% set os_bg = 'var(--ds-background-information, #dbeafe)' %}{% set os_color = 'var(--ds-text-information, #1d4ed8)' %}
                                                                {% elif 'android' in os_lower %}
                                                                    {% set os_bg = 'var(--ds-background-success, #dcfce7)' %}{% set os_color = 'var(--ds-text-success, #15803d)' %}
                                                                {% elif 'windows' in os_lower %}
                                                                    {% set os_bg = 'var(--ds-background-discovery, #ede9fe)' %}{% set os_color = 'var(--ds-text-discovery, #7c3aed)' %}
                                                                {% elif 'apple' in os_lower or 'macos' in os_lower or 'ios' in os_lower %}
                                                                    {% set os_bg = 'var(--ds-background-danger, #fce7f3)' %}{% set os_color = 'var(--ds-text-danger, #be185d)' %}
                                                                {% else %}
                                                                    {% set os_bg = 'var(--ds-background-neutral, #f3f4f6)' %}{% set os_color = 'var(--ds-text, #4b5563)' %}
                                                                {% endif %}
                                                                <span style="display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; white-space: nowrap; background: {{ os_bg }}; color: {{ os_color }};">{{ os }}</span>
                                                            </td>
                                                            <td class="confluenceTd" style="padding: 12px 14px; border-bottom: 1px solid var(--ds-border, #e5e7eb); vertical-align: middle;">
                                                                <span style="font-size: 12px; font-weight: 700; color: var(--ds-text, #374151);">{{ build.conan_settings.get('arch', '—') }}</span>
                                                            </td>
                                                            <td class="confluenceTd" style="padding: 12px 14px; border-bottom: 1px solid var(--ds-border, #e5e7eb); vertical-align: middle; font-size: 12px; color: var(--ds-text-subtle, #6b7280);">
                                                                {{ build.conan_settings.get('compiler', '') }} {{ build.conan_settings.get('compiler.version', '') }}
                                                            </td>
                                                            <td class="confluenceTd" style="padding: 12px 14px; border-bottom: 1px solid var(--ds-border, #e5e7eb); vertical-align: middle; font-size: 12px;">
                                                                {% if build.docker_image %}
                                                                    <a href="https://{{ build.docker_image }}" style="color: var(--ds-link, #2563eb); font-weight: 500; text-decoration: none;">{{ build.docker_image.split('/')[-1] }} &#8599;</a>
                                                                {% else %}
                                                                    <span style="color: var(--ds-text-subtlest, #9ca3af);">—</span>
                                                                {% endif %}
                                                            </td>
                                                        </tr>
                                                        {% endfor %}
                                                    </tbody>
                                                </table>
                                            </ac:rich-text-body>
                                        </ac:structured-macro>
                                    {% endif %}

                                </div>
                                {% endfor %}
                            </ac:rich-text-body>
                        </ac:structured-macro>
                        {% endfor %}
                    </ac:rich-text-body>
                </ac:structured-macro>
                
            </ac:rich-text-body>
        </ac:structured-macro>
        {% endfor %}

    </ac:rich-text-body>
</ac:structured-macro>