{# Combined release view: full component table + Docker profiles section #}
<h1>Документация релиза платформы {{ platform_version }}</h1>
<p><em>Сформировано: {{ generated_at }}</em></p>

<h2>Компоненты платформы</h2>
<table>
  <thead>
    <tr>
      <th>Компонент</th>
      <th>Версия</th>
      <th>Канал</th>
      <th>Conan reference</th>
      <th>Artifactory</th>
      {% if include_passport_links %}<th>Паспорт</th>{% endif %}
    </tr>
  </thead>
  <tbody>
    {% for comp in components %}
      {% for rel in comp.releases %}
    <tr>
      <td>
        {% if comp.git_repo %}
          <a href="{{ rel.git_url }}">{{ comp.name }}</a>
        {% else %}
          {{ comp.name }}
        {% endif %}
      </td>
      <td>{{ rel.version }}</td>
      <td>{{ rel.channel }}</td>
      <td>{{ rel.conan_reference or '—' }}</td>
      <td>
        {% if rel.artifactory_url %}
          <a href="{{ rel.artifactory_url }}">Artifactory</a>
        {% else %}—{% endif %}
      </td>
      {% if include_passport_links %}
      <td>
        {% if comp.passport_link %}
          <a href="{{ comp.passport_link }}">Паспорт</a>
        {% else %}—{% endif %}
      </td>
      {% endif %}
    </tr>
      {% endfor %}
    {% endfor %}
  </tbody>
</table>

<h2>Docker-образы профилей сборки</h2>
{% for comp in components %}
  {% for rel in comp.releases %}
    {% if rel.profile_builds %}
<h3>{{ comp.name }} {{ rel.version }}</h3>
<table>
  <thead>
    <tr>
      <th>Профиль</th>
      <th>Docker-образ</th>
      <th>Варианты</th>
    </tr>
  </thead>
  <tbody>
      {% for pb in rel.profile_builds %}
    <tr>
      <td>{{ pb.profile_name }}</td>
      <td>{{ pb.docker_image or '—' }}</td>
      <td>{{ pb.variants | length }}</td>
    </tr>
      {% endfor %}
  </tbody>
</table>
    {% endif %}
  {% endfor %}
{% endfor %}
