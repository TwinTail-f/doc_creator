<ac:structured-macro ac:name="tabs-group">
    <ac:parameter ac:name="disposition">vertical</ac:parameter>
    <ac:parameter ac:name="outline">true</ac:parameter>
    
    <ac:rich-text-body>
        
        {% for profile in data.profiles %}
        {% set prof_index = loop.index %}
        <ac:structured-macro ac:name="tab-pane">
            
            <ac:parameter ac:name="name">{{ profile.profile_name }}</ac:parameter>
            <ac:parameter ac:name="anchor">prof-{{ prof_index }}</ac:parameter>
            <ac:parameter ac:name="outline">true</ac:parameter>
            
            <ac:rich-text-body>
                
                <!-- Заголовок профиля -->
                <h1 style="margin-top: 0; margin-bottom: 6px; font-size: 24px; font-weight: 700; color: var(--ds-text, #111827); font-family: monospace;">{{ profile.profile_name }}</h1>
                
                <!-- Информация об окружении профиля -->
                <div style="margin-top: 12px; margin-bottom: 24px;">
                    
                    {% set os_lower = profile.os | lower %}
                    {% if 'linux' in os_lower %}
                        {% set os_bg = 'var(--ds-background-information, #dbeafe)' %}{% set os_color = 'var(--ds-text-information, #1d4ed8)' %}
                    {% elif 'android' in os_lower %}
                        {% set os_bg = 'var(--ds-background-success, #dcfce7)' %}{% set os_color = 'var(--ds-text-success, #15803d)' %}
                    {% elif 'windows' in os_lower %}
                        {% set os_bg = 'var(--ds-background-discovery, #ede9fe)' %}{% set os_color = 'var(--ds-text-discovery, #7c3aed)' %}
                    {% elif 'apple' in os_lower or 'macos' in os_lower or 'ios' in os_lower %}
                        {% set os_bg = 'var(--ds-background-danger, #fce7f3)' %}{% set os_color = 'var(--ds-text-danger, #be185d)' %}
                    {% else %}
                        {% set os_bg = 'var(--ds-background-neutral, #e5e7eb)' %}{% set os_color = 'var(--ds-text, #4b5563)' %}
                    {% endif %}
                    
                    <span style="font-size: 12px; background: var(--ds-background-neutral, #f3f4f6); border-radius: 4px; padding: 2px 8px; margin-right: 12px; display: inline-block; margin-bottom: 8px; color: var(--ds-text-subtle, #6b7280);">
                        OS: <strong style="background: {{ os_bg }}; color: {{ os_color }}; padding: 1px 6px; border-radius: 4px; margin-left: 4px;">{{ profile.os }}</strong>
                    </span>
                    
                    <span style="font-size: 12px; color: var(--ds-text-subtle, #6b7280); background: var(--ds-background-neutral, #f3f4f6); border-radius: 4px; padding: 2px 8px; margin-right: 12px; display: inline-block; margin-bottom: 8px;">
                        Архитектура: <strong style="color: var(--ds-text, #374151);">{{ profile.arch }}</strong>
                    </span>
                    
                    <span style="font-size: 12px; color: var(--ds-text-subtle, #6b7280); background: var(--ds-background-neutral, #f3f4f6); border-radius: 4px; padding: 2px 8px; margin-right: 12px; display: inline-block; margin-bottom: 8px;">
                        Компилятор: <strong style="color: var(--ds-text, #374151);">{{ profile.compiler }} {{ profile.compiler_version }}</strong>
                    </span>

                    <span style="font-size: 12px; color: var(--ds-text-subtle, #6b7280); background: var(--ds-background-neutral, #f3f4f6); border-radius: 4px; padding: 2px 8px; margin-right: 12px; display: inline-block; margin-bottom: 8px;">
                        Docker: 
                        {% if profile.docker_url %}
                            <a href="https://{{ profile.docker_url }}" style="color: var(--ds-link, #2563eb); font-weight: 600; text-decoration: none; margin-left: 4px;">{{ profile.docker_url.split('/')[-1] }}</a>
                        {% else %}
                            <strong style="color: var(--ds-text, #374151); margin-left: 4px;">—</strong>
                        {% endif %}
                    </span>
                </div>

                <!-- ГОРИЗОНТАЛЬНЫЕ ВКЛАДКИ КАНАЛОВ -->
                <ac:structured-macro ac:name="tabs-group">
                    <ac:parameter ac:name="disposition">horizontal</ac:parameter>
                    <ac:parameter ac:name="outline">true</ac:parameter>
                    
                    <ac:rich-text-body>
                        
                        {% for channel_name, components in profile.channels.items() %}
                        <ac:structured-macro ac:name="tab-pane">
                            
                            <ac:parameter ac:name="name">{{ channel_name | capitalize }} ({{ components | length }})</ac:parameter>
                            <ac:parameter ac:name="anchor">prof-{{ prof_index }}-chan-{{ loop.index }}</ac:parameter>
                            <ac:parameter ac:name="outline">true</ac:parameter>
                            
                            <ac:rich-text-body>
                                
                                <div style="margin-top: 16px; margin-bottom: 24px;">
                                    <h4 style="font-size: 13px; font-weight: 600; color: var(--ds-text, #374151); margin-bottom: 10px; text-transform: uppercase; letter-spacing: .05em;">Собранные компоненты</h4>
                                    
                                    <table class="confluenceTable" style="border: 1px solid var(--ds-border, #e5e7eb); border-radius: 8px; margin-bottom: 0; width: 100%;">
                                        <thead style="background: var(--ds-surface-sunken, #f9fafb);">
                                            <tr>
                                                <th class="confluenceTh" style="padding: 10px 14px; text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--ds-text-subtle, #6b7280); border-bottom: 1px solid var(--ds-border, #e5e7eb);">Компонент</th>
                                                <th class="confluenceTh" style="padding: 10px 14px; text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--ds-text-subtle, #6b7280); border-bottom: 1px solid var(--ds-border, #e5e7eb);">Версия</th>
                                                <th class="confluenceTh" style="padding: 10px 14px; text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--ds-text-subtle, #6b7280); border-bottom: 1px solid var(--ds-border, #e5e7eb);">Conan Reference</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for comp in components %}
                                            <tr>
                                                <td class="confluenceTd" style="padding: 12px 14px; border-bottom: 1px solid var(--ds-border, #e5e7eb); vertical-align: middle;">
                                                    <strong style="color: var(--ds-text, #111827); font-size: 13px;">{{ comp.name }}</strong>
                                                </td>
                                                <td class="confluenceTd" style="padding: 12px 14px; border-bottom: 1px solid var(--ds-border, #e5e7eb); vertical-align: middle;">
                                                    <span style="font-size: 12px; color: var(--ds-text, #374151);">{{ comp.version }}</span>
                                                </td>
                                                <td class="confluenceTd" style="padding: 12px 14px; border-bottom: 1px solid var(--ds-border, #e5e7eb); vertical-align: middle;">
                                                    <a href="{{ comp.url }}" style="font-family: monospace; font-size: 12px; font-weight: 600; color: var(--ds-link, #2563eb); text-decoration: none;">
                                                        {{ comp.reference }} &#8599;
                                                    </a>
                                                </td>
                                            </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>

                            </ac:rich-text-body>
                        </ac:structured-macro>
                        {% endfor %}

                    </ac:rich-text-body>
                </ac:structured-macro>
                
            </ac:rich-text-body>
        </ac:structured-macro>
        {% endfor %}

    </ac:rich-text-body>
</ac:structured-macro>