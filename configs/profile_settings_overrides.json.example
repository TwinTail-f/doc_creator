{
  "_comment": [
    "Этот файл — костыль для профилей, использующих Jinja-шаблоны с os.getenv().",
    "Если профиль требует env-переменные (например KOS_SDK_VER для compiler.toolchain_config_id),",
    "но они не заданы в окружении, опишите здесь нужные -s настройки явно.",
    "Каждая группа 'overrides' связывает список профилей с набором settings.",
    "Одни и те же settings можно задать для нескольких профилей в одной группе.",
    "Для разных значений одного параметра — создайте отдельные группы."
  ],

  "overrides": [
    {
      "_comment": "Профили KOS KISG x86_64 — toolchain v3.1.0.130",
      "profiles": [
        "kos-kisg-x86_64-pc-clang.jinja",
        "mobile-kos-kisg-x86_64-pc.jinja"
      ],
      "settings": {
        "compiler.toolchain_config_id": "kos-kisg-3.1.0.130"
      }
    },
    {
      "_comment": "Профили KOS x86_64 (без kisg) — toolchain v2.1.2.31",
      "profiles": [
        "kos-x86_64-pc-clang.jinja",
        "mobile-kos-x86_64-pc.jinja"
      ],
      "settings": {
        "compiler.toolchain_config_id": "kos-x86_64-2.1.2.31"
      }
    },
    {
      "_comment": "Профили aarch64 — другой toolchain и другой параметр settings",
      "profiles": [
        "mobile-kos-aarch64.jinja"
      ],
      "settings": {
        "compiler.toolchain_config_id": "kos-aarch64-2.1.0.49",
        "compiler.version": "12"
      }
    }
  ]
}
